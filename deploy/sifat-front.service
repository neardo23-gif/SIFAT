# systemd: /etc/systemd/system/sifat-front.service
# Instalar:  sudo systemctl daemon-reload && sudo systemctl enable --now sifat-front
# Bitácora:  journalctl -u sifat-front -f
[Unit]
Description=SIFAT front (Flask + gunicorn)
# El front necesita al backend para iniciar sesión y leer datos
After=network-online.target sifat-backend.service
Wants=network-online.target

[Service]
Type=simple
User=sifat
Group=sifat
WorkingDirectory=/opt/sifat/front
# El .env vive junto al código, con permisos 600 y dueño sifat
ExecStart=/opt/sifat/front/.venv/bin/gunicorn -c gunicorn.conf.py app:app
Restart=on-failure
RestartSec=3

# Endurecimiento: el proceso no puede escribir fuera de lo necesario
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadOnlyPaths=/opt/sifat/front

[Install]
WantedBy=multi-user.target
