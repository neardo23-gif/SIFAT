# URL de invocación de API Gateway (etapa dev), sin "/servicios" al final
API_BASE_URL=https://4er7ekb4h6.execute-api.us-east-1.amazonaws.com/dev

# Valor de la clave "sifat-frontend" (API Gateway > Claves de API > Show).
# Pásala por mensaje privado: el archivo .env no se sube al repo.
API_KEY=

# Backend propio (repo SIFAT-BACKEND). La clave es la misma BACKEND_API_KEY de su .env
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=

# true = datos de ejemplo en memoria. false (por defecto) = servicios reales.
USE_MOCK=false

# true solo mientras desarrollas: el depurador de Flask nunca debe quedar expuesto
FLASK_DEBUG=false

# Puerto local. En Mac usa 5001: el 5000 lo ocupa el Receptor AirPlay
PORT=5000

# Firma la cookie de sesión (protección CSRF). Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# true cuando el sitio se publique con HTTPS: la cookie de sesión solo viaja cifrada
SESSION_COOKIE_SECURE=false
