# Copia este archivo a .env y llena los valores. El .env nunca se sube al repo.

# development (por defecto) o production. En production la app NO arranca si
# falta algo de lo marcado con [prod] o si la configuración es insegura.
APP_ENV=development

# [prod] URL de invocación de API Gateway (etapa dev), sin "/servicios" al final
API_BASE_URL=https://4er7ekb4h6.execute-api.us-east-1.amazonaws.com/dev

# [prod] Valor de la clave "sifat-frontend" (API Gateway > Claves de API > Show).
# Pásala por mensaje privado.
API_KEY=

# [prod] Backend propio (repo SIFAT-BACKEND). La clave es la misma BACKEND_API_KEY de su .env
BACKEND_URL=http://127.0.0.1:8000
BACKEND_API_KEY=

# true = datos de ejemplo en memoria (solo lectura, sin login). [prod] debe ser false.
USE_MOCK=false

# [prod] Firma la cookie de sesión. Mínimo 32 caracteres. Genera una con:
#   python3 -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# [prod] true cuando el sitio se sirve por HTTPS: la cookie solo viaja cifrada
# y se envía la cabecera HSTS.
SESSION_COOKIE_SECURE=false

# true solo detrás de nginx (usa X-Forwarded-For para conocer la IP real).
# Sin proxy debe ser false: cualquiera podría falsificar esa cabecera.
TRUST_PROXY=false

# true solo mientras desarrollas: el depurador de Flask nunca debe quedar expuesto
FLASK_DEBUG=false

# Puerto local. En Mac el 5000 lo ocupa el Receptor AirPlay; gunicorn usa 5001 por defecto.
PORT=5000
